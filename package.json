{
  "name": "teppi-client",
  "version": "0.10.0",
  "description": "Check an x402 seller before your agent pays it: one GET to the Teppi record of what paying it delivered, a fetch wrapper that refuses a failing listing or an overcharge before signing, and pay only on delivery.",
  "keywords": [
    "x402",
    "http-402",
    "check-before-paying",
    "x402-seller",
    "pay-on-delivery",
    "agents",
    "payments",
    "verification",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teppi-xyz/teppi-client"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf npm && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "files": [
    "npm",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": "./npm/index.js"
    },
    "types": "./npm/index.d.ts"
  },
  "homepage": "https://api.teppi.xyz/docs/integrations"
}
